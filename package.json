{
  "name": "@digitalmedika/bpjs-vclaim",
  "version": "0.1.2",
  "description": "TypeScript wrapper for BPJS VClaim API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billymontolalu/bpjs-vclaim.git"
  },
  "homepage": "https://github.com/billymontolalu/bpjs-vclaim#readme",
  "bugs": {
    "url": "https://github.com/billymontolalu/bpjs-vclaim/issues"
  },
  "keywords": [
    "bpjs",
    "vclaim",
    "jkn",
    "typescript",
    "indonesia"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  }
}